    "/api/cookbook/gpus": {
      "get": {
        "description": "Probe GPU memory/process state locally or via SSH.

Probe order:
    1. NVIDIA via nvidia-smi
    2. AMD/ROCm and unified-memory APUs via /sys/class/drm
    3. Generic GPU device holders via /dev/kfd and /dev/dri/renderD*

Returned shape:
    { "ok": True, "gpus": [
        {"index": 0, "name": "...", "free_mb": int, "total_mb": int,
         "used_mb": int, "util_pct": int, "busy": bool,
         "uuid": "GPU-...",
         "processes": [{"pid": int, "name": str, "used_mb": int}, ...]
        }, ...
    ]}
\`busy\` is True when free_mb/total_mb < 0.5.",
        "operationId": "list_gpus_api_cookbook_gpus_get",
        "parameters": [
          {
            "in": "query",
            "name": "host",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "title": "Host",
            },
          },
          {
            "in": "query",
            "name": "ssh_port",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "null",
                },
              ],
              "title": "Ssh Port",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
            },
            "description": "Successful Response",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError",
                },
              },
            },
            "description": "Validation Error",
          },
        },
        "summary": "List Gpus",
        "tags": [
          "cookbook",
        ],
      },
    },
