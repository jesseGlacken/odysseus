            "title": "System Prompt",
            "type": "string",
          },
          "temperature": {
            "default": 1,
            "maximum": 2,
            "minimum": 0,
            "title": "Temperature",
            "type": "number",
          },
        },
        "required": [
          "name",
        ],
        "title": "UserTemplateRequest",
        "type": "object",
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object",
          },
          "input": {
            "title": "Input",
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string",
                },
                {
                  "type": "integer",
                },
              ],
            },
            "title": "Location",
            "type": "array",
          },
          "msg": {
            "title": "Message",
            "type": "string",
          },
          "type": {
            "title": "Error Type",
            "type": "string",
          },
        },
        "required": [
          "loc",
          "msg",
          "type",
        ],
        "title": "ValidationError",
        "type": "object",
      },
      "VaultConfig": {
        "properties": {
          "email": {
            "default": "",
            "title": "Email",
            "type": "string",
          },
          "server_url": {
            "default": "",
            "title": "Server Url",
            "type": "string",
          },
        },
        "title": "VaultConfig",
        "type": "object",
      },
      "VaultLoginRequest": {
        "properties": {
          "email": {
            "title": "Email",
            "type": "string",
          },
          "master_password": {
            "title": "Master Password",
            "type": "string",
          },
        },
        "required": [
          "email",
          "master_password",
        ],
        "title": "VaultLoginRequest",
        "type": "object",
      },
      "VaultUnlockRequest": {
        "properties": {
          "master_password": {
            "title": "Master Password",
            "type": "string",
          },
        },
        "required": [
          "master_password",
        ],
        "title": "VaultUnlockRequest",
        "type": "object",
      },
      "routes__auth_models__SetupRequest": {
        "properties": {
          "password": {
            "description": "Plain-text password for the first admin",
            "title": "Password",
            "type": "string",
          },
          "username": {
            "description": "Username for the first admin account",
            "title": "Username",
            "type": "string",
          },
        },
        "required": [
          "username",
          "password",
        ],
        "title": "SetupRequest",
        "type": "object",
      },
      "routes__cookbook_routes__setup_cookbook_routes___locals___SetupRequest": {
        "properties": {
          "host": {
            "title": "Host",
            "type": "string",
          },
          "ssh_port": {
            "anyOf": [
              {
                "type": "string",
              },
              {
                "type": "null",
              },
            ],
            "title": "Ssh Port",
          },
        },
        "required": [
          "host",
        ],
        "title": "SetupRequest",
        "type": "object",
      },
    },
  },
