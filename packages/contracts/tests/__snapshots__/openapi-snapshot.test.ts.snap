    "/api/upload/{file_id}": {
      "get": {
        "description": "Serve an uploaded file by its ID. \`?thumb=1\` returns a small cached
JPEG thumbnail for images (used by chat attachment previews) so the
client isn't downloading the full-resolution photo just to show it tiny.",
        "operationId": "download_file_api_upload__file_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "title": "File Id",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "thumb",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Thumb",
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
            },
            "description": "Successful Response",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError",
                },
              },
            },
            "description": "Validation Error",
          },
        },
        "summary": "Download File",
        "tags": [
          "upload",
        ],
      },
    },
    "/api/upload/{file_id}/vision": {
      "get": {
        "description": "Return the vision-model OCR/description for an uploaded image.
Cached under UPLOAD_DIR/.vision/{file_id}.txt — first call computes,
subsequent loads are instant. Pass force=1 to recompute.",
        "operationId": "get_vision_text_api_upload__file_id__vision_get",
        "parameters": [
          {
            "in": "path",
            "name": "file_id",
            "required": true,
            "schema": {
              "title": "File Id",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "force",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Force",
              "type": "integer",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
            },
            "description": "Successful Response",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError",
                },
              },
            },
            "description": "Validation Error",
          },
        },
        "summary": "Get Vision Text",
        "tags": [
          "upload",
        ],
      },
      "put": {
        "description": "Persist a user-edited vision/OCR text for an attachment. Stored in
the same cache file so the chat send picks it up as the override.",
