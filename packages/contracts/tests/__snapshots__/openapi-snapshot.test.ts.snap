            "content": {
              "application/json": {
                "schema": {},
              },
              "text/event-stream": {
                "schema": {
                  "description": "SSE event stream. Each event has an event: type and data: payload.",
                  "properties": {
                    "data": {
                      "description": "JSON-encoded event payload",
                      "type": "string",
                    },
                    "event": {
                      "description": "Event type (e.g. token, tool_start, tool_output, done, error)",
                      "type": "string",
