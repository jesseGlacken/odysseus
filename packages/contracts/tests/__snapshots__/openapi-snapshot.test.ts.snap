              "title": "File Id",
              "type": "string",
            },
          },
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
            },
            "description": "Successful Response",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError",
                },
              },
            },
            "description": "Validation Error",
          },
        },
        "summary": "Put Vision Text",
        "tags": [
          "upload",
        ],
      },
