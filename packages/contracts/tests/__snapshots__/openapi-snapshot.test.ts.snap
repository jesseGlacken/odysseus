    "/api/shell/stream": {
      "post": {
        "description": "Stream shell command output. Events: stdout (output line), stderr (error line), exit (exit code), error (failure).",
        "operationId": "shell_stream_api_shell_stream_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShellExecRequest",
              },
            },
          },
          "required": true,
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {},
              },
              "text/event-stream": {
                "schema": {
                  "description": "SSE event stream. Each event has an event: type and data: payload.",
                  "properties": {
                    "data": {
                      "description": "JSON-encoded event payload",
                      "type": "string",
                    },
                    "event": {
                      "description": "Event type (e.g. token, tool_start, tool_output, done, error)",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
              },
            },
            "description": "Server-Sent Events stream",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError",
                },
              },
            },
            "description": "Validation Error",
          },
        },
        "summary": "Shell Stream",
        "tags": [
          "shell",
        ],
      },
    },
