            "schema": {
              "default": "",
              "title": "Quant",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "ctx",
            "required": false,
            "schema": {
              "default": "",
              "title": "Ctx",
              "type": "string",
            },
          },
          {
            "in": "query",
            "name": "gpu_count",
            "required": false,
            "schema": {
              "default": "",
              "title": "Gpu Count",
              "type": "string",
            },
          },
          {
